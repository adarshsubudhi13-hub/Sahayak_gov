# ─────────────────────────────────────────────────────────────
# Sahayak – Environment Variables (copy to .env and fill in)
# ─────────────────────────────────────────────────────────────
# Vite exposes only VITE_-prefixed vars to the browser bundle.

# ── Supabase ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ── Groq API (Primary RAG LLM Provider) ───────────────────────
VITE_GROQ_API_KEY=gsk_...your-groq-key

# ── OpenAI (Alternative RAG LLM Provider) ──────────────────────
VITE_OPENAI_API_KEY=sk-...your-openai-key

# ── RAG Tuning ────────────────────────────────────────────────
VITE_CONFIDENCE_THRESHOLD=0.72

