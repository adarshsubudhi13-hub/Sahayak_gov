# In Vite frontend applications, environment variables MUST be prefixed with VITE_
# Create a file named .env in the project root directory and add one of your API keys below:

# Option 1: OpenAI (e.g. gpt-4o-mini)
VITE_OPENAI_API_KEY=your-openai-api-key-here

# Option 2: Google Gemini (e.g. gemini-1.5-flash)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Option 3: Groq (e.g. llama-3.3-70b)
VITE_GROQ_API_KEY=your-groq-api-key-here
